# Copy to .env and fill in. .env is gitignored and must never be committed (C9).
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)

# --- required for generation (phase 5). The app starts without it and shows
# --- a friendly message rather than crashing (C13).
GROQ_API_KEY=

# --- LLM ---
# openai/gpt-oss-20b measured best of the models this key can reach (llama-3.1
# is not served by this account). The test asserts a verified family.
GROQ_MODEL=openai/gpt-oss-20b

# --- embeddings. Must be identical for chunks and questions (C7). ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Token window. all-MiniLM-L6-v2 has 512 position embeddings, but
# sentence-transformers ships a default of 256. 512 was verified safe: the ONNX
# export carries the full position table and matches torch at cos 1.000000.
# CHUNK_SIZE is derived from this number - see the comment in config.py.
EMBED_MAX_TOKENS=512
# onnx = ~218 MB peak RSS. torch = ~537 MB, which is over Render's 512 MB
# free-tier limit. Leave this alone unless the ONNX weights cannot be fetched.
EMBED_BACKEND=onnx
EMBED_ONNX_FILE=onnx/model.onnx
# Documents per forward pass. A memory knob: one pass over all 54 chunks at once
# peaks at 1988 MB, at 4 it peaks at 275 MB. Vectors are identical either way.
EMBED_BATCH_SIZE=4
# ONNX Runtime's memory arena never returns memory. Off suits a long-running
# server: peak 294 -> 275 MB, retained 294 -> 185 MB.
EMBED_ARENA=0
# Group similar-length documents into a batch to cut padding waste (3.7 -> 2.9s).
EMBED_SORT_BATCHES=1

# --- retrieval ---
TOP_K=5
# MEASURED in phase 5 and LOWERED 0.25 -> 0.20: answerable and unanswerable
# score populations overlap completely (config.py carries the measurement), so
# this is only a gross-mismatch floor, applied to unfiltered searches only.
# The real absent-fact defence is the post-generation number-grounding check.
MIN_SCORE=0.2

# --- chunking. Frozen by the phase 2 design gate (C6), resized by phase 3. ---
# 250 words, not the original 400: measured over the real corpus this content
# runs 1.19-2.02 tokens per word, so 400 words reached 835 tokens and would have
# been silently truncated by the embedding window.
CHUNK_SIZE=230
CHUNK_OVERLAP=80
MIN_SIZE=60
PREPEND_BREADCRUMB=1

# --- paths ---
# Relative is fine: config.py resolves it, because chromadb resolves a relative
# path against the process working directory instead.
CHROMA_PATH=data/chroma

# --- behaviour ---
# 1 = read data/clean/ and skip fetching. Set this on Render.
RAG_OFFLINE=0
# 1 = if the store is empty at app start, re-ingest from data/clean/ once per
# session. Needed on Streamlit Community Cloud (no custom start command and
# data/chroma/ is gitignored, so a cold start finds an empty store). Locally
# leave 0: the documented `ingest --offline` step builds the index.
RAG_CLOUD_AUTO_INGEST=0
LOG_LEVEL=INFO

# --- conversation memory (chat follow-ups) ---
# The last N turns the rewriter may look at when a follow-up lacks a subject
# ("what about its fees?" -> "What is the expense ratio of HDFC Flexi Cap
# Fund Direct Growth?"). 10 = the latest 5 Q/A exchanges. The rewrite fails
# open: no history, missing key or network error all fall back to the
# stateless pipeline (see rag/memory.py).
MEMORY_MESSAGES=10
# Rewrites are short single-question completions, so their budget sits well
# below MAX_TOKENS (still leaving room for the model's reasoning tokens).
MEMORY_REWRITE_MAX_TOKENS=256
