# ============================================================
# Secrets - never commit (PRD constraint C9)
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Virtual environments
# ============================================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ============================================================
# Python bytecode and caches
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ============================================================
# Generated data - rebuildable, safe to delete
# ============================================================
# Persisted vector index (C8)
data/chroma/
# Cached source HTML
data/raw/

# ============================================================
# DELIBERATELY NOT IGNORED - these must be committed
# ============================================================
#   data/clean/*.txt   offline fallback so the demo survives a
#                      blocked fetch, and is what Render ingests (R2)
#   data/chunks.txt    required deliverable, the chunking review (C6)
#   sources.md         deliverable 2
#   sources.csv        deliverable 2
# If you add a blanket "data/" ignore, the demo breaks on Render.

# ============================================================
# OS / editor noise
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
